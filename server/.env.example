# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000

# MongoDB connection string (Atlas free tier works, or mongodb://127.0.0.1:27017/remedy-setu)
MONGODB_URI=

# Any OpenAI-compatible API. Leave AI_API_KEY empty to run in rule-based mode.
# Groq (free tier): https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# ---- Login ----
# Signs the login cookie. REQUIRED in production: 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first admin account, created on startup if it does not exist yet (password: 8+ characters).
# After that the admin adds the rest of the team on the Team page. There is no public sign-up.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
